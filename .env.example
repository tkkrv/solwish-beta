# --- Solana ---
# Сеть: devnet | testnet | mainnet-beta (beta работает на devnet)
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Свой RPC (Helius / QuickNode) — публичный devnet-RPC сильно ограничен по запросам.
# Пусто = https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Серверный ключ (Project Settings → API → service_role). НЕ добавляйте префикс NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=
# Запасной вариант, если service_role ещё не настроен (работает, только пока RLS выключен).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Сайт ---
# Публичный адрес beta (для OG-картинок и ссылок). На Vercel можно не задавать.
NEXT_PUBLIC_APP_URL=

# --- Telegram-уведомления (необязательно) ---
# Отдельный бот для beta (создайте в @BotFather), чтобы не мешать боту основной версии.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Любая длинная случайная строка; её же передайте в setWebhook (secret_token).
TELEGRAM_WEBHOOK_SECRET=

# Optional: free CoinGecko demo key (fewer 429 errors). Coinbase is used as a fallback anyway.
COINGECKO_API_KEY=

# --- v0.5: AI (необязательно) ---
# Любой OpenAI-совместимый Chat Completions API: OpenAI или Azure OpenAI (https://<resource>.openai.azure.com/openai/v1).
# Без ключа кнопка «Помочь написать» скрыта, а модерация работает только по словарю.
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5-nano

# --- v0.5: монетизация ---
# Кошелёк SolWish для оплаты премиум-открыток. Пусто — премиум-оформление выключено.
NEXT_PUBLIC_SOLWISH_TREASURY=
# Цена премиум-открытки в SOL (не меньше 0.001, чтобы пустой кошелёк-казна мог принять первый платёж).
NEXT_PUBLIC_PREMIUM_CARD_SOL=0.01
# Почта для страниц «Условия» и «Конфиденциальность» (лучше на своём домене).
NEXT_PUBLIC_CONTACT_EMAIL=
# Chat id в Telegram, куда присылать заявки от бизнеса (узнать: отправьте /id вашему боту SolWish).
TELEGRAM_ADMIN_CHAT_ID=
