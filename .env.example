# --- Solana ---
# Сеть: devnet | testnet | mainnet-beta (beta работает на devnet)
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Свой RPC (Helius / QuickNode) — публичный devnet-RPC сильно ограничен по запросам.
# Пусто = https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Серверный ключ (Project Settings → API → service_role). НЕ добавляйте префикс NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=
# Запасной вариант, если service_role ещё не настроен (работает, только пока RLS выключен).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Сайт ---
# Публичный адрес beta (для OG-картинок и ссылок). На Vercel можно не задавать.
NEXT_PUBLIC_APP_URL=
